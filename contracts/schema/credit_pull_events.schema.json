{
  "$schema": "Team1_Personal_Loan_Schema",
  "title": "credit_pull_events",
  "schema_version": "1.1",
  "type": "object",
  "properties": {
    "credit_pull_event_id": {
      "type": "string",
      "pattern": "^EV-[0-9]{3,}$"
    },
    "applicant_id": {
      "type": "string"
    },
    "product_code": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "dti_ratio": {
      "type": "number",
      "minimum": 0
    },
    "credit_score": {
      "type": "integer",
      "minimum": 300,
      "maximum": 850
    },
    "credit_score_tier_change": {
      "type": "string",
      "enum": [
        "Upgraded",
        "Downgraded",
        "No Change",
        "Not Applicable"
      ]
    },
    "pull_status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAILED",
        "PENDING"
      ]
    },
    "bureau_name": {
      "type": "string",
      "enum": [
        "EQUIFAX",
        "TRANSUNION",
        "EXPERIAN"
      ]
    },
    "failure_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "INVALID_REQUEST",
        "TIMEOUT",
        "PROVIDER_ERROR",
        "RATE_LIMITED"
      ]
    },
    "provider_request_id": {
      "type": "string"
    },
    "risk_status": {
      "type": "string",
      "enum": [
        "Low Risk",
        "Moderate Risk",
        "High Risk",
        "Very High Risk"
      ]
    }
  },
  "required": [
    "credit_pull_event_id",
    "applicant_id",
    "product_code",
    "event_date",
    "dti_ratio",
    "pull_status",
    "provider_request_id",
    "risk_status"
  ]
}