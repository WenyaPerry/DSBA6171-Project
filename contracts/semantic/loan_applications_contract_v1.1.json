{
  "$schema": "https://example.com/semantic-contract-schema.json",
  "dataset_name": "loan_applications.csv",
  "version": "1.1.0",
  "dataset_metadata": {
    "description": "Loan application decisions.",
    "business_domain": "Consumer Lending",
